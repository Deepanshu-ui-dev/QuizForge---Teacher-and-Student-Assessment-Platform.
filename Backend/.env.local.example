# Copy when running the backend on your host (outside Docker):
#   cp .env.local.example .env.local
#
# Requires postgres, redis, and rabbitmq from docker compose:
#   docker compose up -d postgres redis rabbitmq

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/quiz_platform
REDIS_URL=redis://localhost:6380
RABBITMQ_URL=amqp://guest:guest@localhost:5672
